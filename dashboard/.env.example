# ─────────────────────────────────────────────────────────────
# Darzi Register admin dashboard — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local
# or any real key / password / secret to git.
# ─────────────────────────────────────────────────────────────

# Supabase project URL. PUBLIC — safe to expose in the browser
# (the anon key it pairs with is scoped by Row Level Security).
# Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. PUBLIC — safe to expose in the browser;
# all access is scoped by RLS policies.
# Supabase Dashboard → Project Settings → API → anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SECRET — SERVER ONLY.
# Bypasses RLS; used only by lib/supabase/server.ts createServiceClient().
# Must never reach the browser, a NEXT_PUBLIC_* var, or committed files.
# Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Secret for signing/verifying license entitlement payloads (HMAC-SHA256).
# SECRET — SERVER ONLY. Never expose to the browser or commit it.
# Generate: 32+ random bytes (hex/base64), stored in a password manager.
ENTITLEMENT_SECRET=
